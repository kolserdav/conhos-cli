{
  "name": "conhos",
  "version": "4.4.12",
  "description": "Command-line interface for the Conhos.ru Config Hosting service.",
  "type": "module",
  "repository": "https://github.com/kolserdav/conhos.git",
  "files": [
    "bin",
    "src"
  ],
  "bin": {
    "conhos": "./bin/conhos"
  },
  "scripts": {
    "build": "tsc -p ./jsconfig.json",
    "script:create-docs": "node src/scripts/create-docs.js",
    "docker-publish": "./src/scripts/sh/docker-publish.sh",
    "pull-image": "docker pull kolserdav/conhos-cli"
  },
  "keywords": [
    "container",
    "hosting",
    "cloud",
    "docker",
    "deploy"
  ],
  "author": "kolserdav",
  "license": "MIT",
  "dependencies": {
    "cache-changed": "^1.3.2",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "conhos-vscode": "^3.0.9",
    "dotenv": "^18.0.7",
    "filesize": "^11.0.26",
    "inquirer": "^14.2.3",
    "open": "^11.0.4",
    "tar": "^7.5.22",
    "uuid": "^14.0.3",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9",
    "@types/node": "^26",
    "@types/ws": "^8",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "date-fns": "^3.6.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "typescript": "^5.7.3"
  },
  "fhead": {
    "root": "src",
    "repository": "Conhos cli",
    "patterns": [
      ".js"
    ],
    "exclude": [
      "node_modules"
    ],
    "name": "Sergey Kolmiller",
    "email": "kolserdav@conhos.ru",
    "license": "MIT",
    "licenseText": "See LICENSE file",
    "copyright": "kolserdav, All rights reserved (c)",
    "renewAll": false
  }
}
